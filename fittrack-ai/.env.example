# ---- App (bundled into the client; public values only) ----
# Supabase project URL and anon (publishable) key. The anon key is safe to ship:
# row-level security is what protects data. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Edge Function secrets (set with `supabase secrets set`, never in the app) ----
# Used from phase 3. Listed here so every variable is documented in one place.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=

# ---- Tests only ----
# Optional. Point the database tests at an existing Postgres (for example a local
# Supabase started with `supabase start`). When unset, `npm run test:db` starts a
# throwaway Postgres cluster with a minimal stand-in for Supabase's auth schema.
TEST_DATABASE_URL=
